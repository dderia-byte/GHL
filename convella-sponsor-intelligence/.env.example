DATABASE_URL=postgresql://convella:convella@localhost:5432/convella_sponsor_intelligence?schema=public
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
GEMINI_API_KEY=
GEMINI_VIDEO_MODEL=gemini-2.5-pro
APP_URL=http://localhost:3000
TRANSCRIPT_PROVIDER=manual
VIDEO_ANALYSIS_PROVIDER=gemini
DEFAULT_ANALYSIS_MODE=FIRST_SPONSOR_ONLY
DEFAULT_CHUNK_SECONDS=60
MAX_UPLOAD_SIZE_MB=250

# Three-stage cost-optimised sponsor-analysis pipeline (src/lib/sponsor-analysis/)
ANALYSIS_PIPELINE_VERSION=2

# Leave blank to fall back to ANTHROPIC_MODEL for both.
CHEAP_TEXT_MODEL=
REASONING_MODEL=

MAX_TRANSCRIPT_WINDOWS=3
TRANSCRIPT_CONTEXT_BEFORE_SECONDS=30
TRANSCRIPT_CONTEXT_AFTER_SECONDS=60
MAX_TRANSCRIPT_MODEL_CHARS=12000

ENABLE_NATIVE_VIDEO_ANALYSIS=true
VIDEO_WINDOW_SECONDS=90
MAX_VIDEO_WINDOWS=3
MAX_NATIVE_VIDEO_CALLS_PER_VIDEO=3
MAX_NATIVE_VIDEO_SECONDS_PER_VIDEO=300
MAX_ESTIMATED_COST_PER_VIDEO_USD=0.15
