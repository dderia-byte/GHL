{
  "name": "evantix-ad-video",
  "version": "1.0.0",
  "private": true,
  "description": "Evantix Group — animated SaaS-style product advert built with Remotion",
  "scripts": {
    "start": "remotion studio",
    "preview": "remotion studio",
    "build": "tsc --noEmit",
    "render:portrait": "remotion render src/index.ts EvantixPortrait out/evantix-linkedin-portrait.mp4 --codec=h264",
    "render:landscape": "remotion render src/index.ts EvantixLandscape out/evantix-linkedin-landscape.mp4 --codec=h264",
    "render:all": "npm run render:portrait && npm run render:landscape",
    "still": "remotion still src/index.ts EvantixLandscape out/still.png",
    "generate:voiceover": "node scripts/generate-voiceover.mjs",
    "generate:voiceover:force": "node scripts/generate-voiceover.mjs --force",
    "generate:audio-manifest": "node scripts/generate-audio-manifest.mjs",
    "generate:music": "node scripts/generate-background-music.mjs",
    "generate:sfx": "node scripts/generate-sound-effects.mjs",
    "generate:audio": "npm run generate:voiceover && npm run generate:audio-manifest && npm run generate:music && npm run generate:sfx"
  },
  "dependencies": {
    "@remotion/cli": "4.0.487",
    "@remotion/eslint-config": "4.0.487",
    "@remotion/google-fonts": "4.0.487",
    "@remotion/transitions": "4.0.487",
    "dotenv": "^17.4.2",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "music-metadata": "^11.13.0",
    "openai": "^6.46.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.487"
  },
  "devDependencies": {
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "5.6.3"
  }
}
